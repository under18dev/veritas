{
  "name": "veritas-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings . && depcruise packages --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:acceptance": "pnpm build && vitest run --project acceptance",
    "schemas": "pnpm build && node scripts/export-schemas.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "clean": "tsc -b --clean",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "@under18dev/veritas": "workspace:*",
    "@under18dev/veritas-core": "workspace:*",
    "@under18dev/veritas-engine": "workspace:*",
    "@under18dev/veritas-reports": "workspace:*",
    "@under18dev/veritas-test-runner-jest": "workspace:*",
    "@under18dev/veritas-test-runner-node": "workspace:*",
    "@under18dev/veritas-test-runner-vitest": "workspace:*",
    "dependency-cruiser": "18.8.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitest": "5.1.1",
    "yaml": "2.8.3"
  }
}
