{
  "$id": "https://veritas.invalid/schemas/improvement-plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string"
    },
    "targetedPropertyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "observedGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "findingId",
          "description"
        ]
      }
    },
    "proposedTestCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "name",
          "input",
          "rationale"
        ]
      }
    },
    "patchPreview": {
      "type": "string"
    },
    "expectedImpact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxPatchFiles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTestRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeBudgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "solverTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxIterations",
        "maxPatchFiles",
        "maxTestRetries",
        "timeBudgetMs",
        "tokenBudget",
        "solverTimeoutMs"
      ]
    },
    "touchesProductionCode": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "goal",
    "targetedPropertyIds",
    "observedGaps",
    "proposedTestCases",
    "patchPreview",
    "expectedImpact",
    "risks",
    "commands",
    "budget",
    "touchesProductionCode",
    "createdAt"
  ]
}
