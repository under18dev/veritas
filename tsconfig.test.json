{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/llm-providers/*/test/**/*.ts",
    "packages/test-runners/*/test/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
