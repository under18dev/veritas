{
  "name": "@under18dev/veritas-github-action",
  "version": "0.2.1",
  "description": "GitHub Action running Veritas on pull requests",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/under18dev/veritas.git",
    "directory": "packages/github-action"
  },
  "type": "module",
  "exports": {
